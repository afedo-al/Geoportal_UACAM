# Copia este archivo como .env (o define estas variables en el servicio del sistema). Nunca subas el .env al repositorio.

# Obligatorias en producción
GEOPORTAL_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
GEOPORTAL_ALLOWED_HOSTS=geoportal.ejemplo.mx

# Base de datos (sin esta variable se usa SQLite en la carpeta de datos; para producción, PostgreSQL)
GEOPORTAL_DATABASE_URL=postgresql://geoportal:contrasena@127.0.0.1:5432/geoportal

# Carpeta de datos del servicio (fotografías y, si no hay PostgreSQL, la base SQLite). nginx no debe servirla.
GEOPORTAL_DATA_DIR=/srv/geoportal/datos

# Detrás de nginx en el mismo equipo
GEOPORTAL_TRUST_PROXY=1
GEOPORTAL_CSRF_TRUSTED_ORIGINS=https://geoportal.ejemplo.mx

# Opcionales (valor por omisión entre paréntesis)
# GEOPORTAL_DEBUG=0                 (0) nunca 1 en producción
# GEOPORTAL_SECURE_COOKIES=1        (1 sin DEBUG) cookies Secure con prefijo __Host-
# GEOPORTAL_SESSION_MAX_HOURS=8     (8)
# GEOPORTAL_IDLE_MINUTES=30         (30)
# GEOPORTAL_MAX_BODY_MB=40          (40)
# GEOPORTAL_LOG_LEVEL=INFO          (INFO)
